# Copy to a private .env for a NEW stack; never commit filled values.
# Replace with an image you built and made available on your Docker host.
RK_IMAGE=rk-gaming-manager:phase1
RK_DB_PASSWORD=replace-with-a-long-random-password
# Generate separately: openssl rand -base64 32
RK_DB_ENCRYPTION_KEY=replace-with-a-generated-key
RK_BIND_ADDRESS=127.0.0.1
RK_PORT=8010
RK_IGDB_CLIENT_ID=
RK_IGDB_CLIENT_SECRET=
